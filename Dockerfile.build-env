FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libcurl4-openssl-dev \
        libjsoncpp-dev \
        libpq-dev \
        libssl-dev \
        libsrt-openssl-dev \
        pkg-config \
        rapidjson-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
